# Copy to .env, fill in, chmod 600. Never commit .env.

# --- VPN provider (Gluetun) ---------------------------------------------
# Provider name as Gluetun spells it: protonvpn, mullvad, nordvpn, ...
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=protonvpn
# Country (or comma-separated list) Gluetun may pick servers from.
SERVER_COUNTRIES=Switzerland
# From the WireGuard .conf your provider gives you: the PrivateKey line and
# the Address line. Nothing else from that file is needed.
WIREGUARD_PRIVATE_KEY=REPLACE_ME
WIREGUARD_ADDRESSES=10.2.0.2/32

# --- Tailscale -----------------------------------------------------------
# Hostname shown in your tailnet. Make it say what it is.
TS_HOSTNAME=vpn-exit

# --- LAN address for the stack (macvlan) ----------------------------------
# A free IP on the same subnet as the box, OUTSIDE your DHCP pool, or reserved
# on the router for EXIT_MAC. The parent interface is the box's wired NIC
# (`ip -br link` to list; eth0, eno1, enp3s0 ...).
EXIT_PARENT_IF=eth0
EXIT_LAN_IP=192.168.1.250
EXIT_LAN_SUBNET=192.168.1.0/24
EXIT_LAN_GATEWAY=192.168.1.1
# Locally-administered MAC (second hex digit 2, 6, A or E). Keep it fixed.
EXIT_MAC=02:42:ac:11:00:fe

# --- Paths and naming -------------------------------------------------------
# Absolute path of this directory on the host (the updater mounts it).
STACK_DIR=/opt/vpn-exit
# Root-owned directory where the updater writes update-status.json.
STATUS_DIR=/opt/vpn-exit/status
# Compose project / container-name prefix.
STACK_NAME=vpn-exit

# --- Time ----------------------------------------------------------------
# IANA zone for the Gluetun container's logs.
TZ=UTC
# POSIX TZ string for the updater (its image has no tzdata).
# Examples: UTC | CET-1CEST,M3.5.0,M10.5.0/3 | NZST-12NZDT,M9.5.0,M4.1.0/3
UPDATER_TZ=UTC
# Local hour (0-23) for the nightly update.
UPDATER_RUN_HOUR=4
